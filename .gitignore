# 環境変数（各環境固有）
.env

# ワールドデータ＋設定ファイル統合（各環境固有、永続化）
worlds/

# Azure AD認証セッション（認証トークンを含む）
sessions/

# ログファイル（ディレクトリ全体）
chat_logs/
logs/
*.log


# VSCode設定（各環境固有）
.vscode/

# LoggiFly通知設定（トークン等の秘密情報を含む）
# config.yaml.example をコピーして config.yaml を作成すること
loggifly/config.yaml

# Apprise通知設定（トークン等の秘密情報を含む）
# minecraft.yml.example をコピーして minecraft.yml を作成すること
apprise/minecraft.yml

# Vector通知設定（ntfy トピック等の環境固有設定を含む）
# vector.toml.example をコピーして vector.toml を作成すること
vector/vector.toml

# ワールド compose ファイル（make add で自動生成）
# docker-compose.world{N}.yml.example（テンプレート）は Git 管理対象
docker-compose.world[0-9]*.yml

# claude関連
CLAUDE.md
.claude

専用サーバーサンプルツール.ipynb
docs/

# サーバー招待受け入れツール（作業中・配布物）
tooling/

# サーバーモジュール
server/