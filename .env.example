# ================================================
# ボリューム設定
# ================================================

VOLUMES_BASE_PATH=./
# ボリュームのベースパス（末尾に / を付ける）
# ローカル開発環境: ./
# NASやリモートストレージ: /share/Public/minecraft-edu/
# 使用可能な値: 相対パス（./）または絶対パス（/path/to/...）

# ================================================
# サーバー基本設定
# ================================================

# サーバー公開アドレス（LAN 内 / LAN 外）
# LAN 内クライアント向けと、インターネット経由アクセス向けの2つを定義し、
# ワールドごとに SERVER_NETWORK で使うほうを切り替える。
# 注意: Dockerコンテナとしてサーバーをホストしているマシンのアドレスを指定してください
# 使用可能な値: ポート番号を含まない有効なIPアドレスまたはドメイン名
SERVER_PUBLIC_IP_LAN=
# LAN 内からの接続先（DockerホストのプライベートIP。例: 192.168.1.100）
SERVER_PUBLIC_IP_WAN=
# LAN 外からの接続先（グローバルIP またはドメイン名。例: 203.0.113.1, your-server.example.com）

# 各ワールドがどちらのアドレスを使うか: "lan"（デフォルト）または "wan"
# 優先順位: 個別（SERVER_NETWORK_WORLD_N）> 共通（SERVER_NETWORK_COMMON）> デフォルト(lan)
SERVER_NETWORK_COMMON=lan
# SERVER_NETWORK_WORLD_1=
# SERVER_NETWORK_WORLD_2=

# ================================================
# トランスポートプロトコル
# ================================================
# この Docker 構成は UDP ポートを直接公開し、クライアントが IP:ポートで接続する方式のため
# "raknet" を使用します。
# 新バージョン（1.26.32.0〜）のデフォルトは "nethernet"（Microsoft のシグナリング経由）ですが、
# nethernet のままだと直接 IP 接続が従来通り動作しない可能性があるため raknet を明示します。
# 使用可能な値: "raknet" または "nethernet"

TRANSPORT_COMMON=raknet
# TRANSPORT_WORLD_1=
# TRANSPORT_WORLD_2=

# ================================================
# 差分管理について
# ================================================
# - 全ワールド共通の値を _COMMON に設定する
# - ワールドごとに変えたい項目だけ _WORLD_N のコメントを外して値を設定する
# - _WORLD_N を設定しなければ自動的に _COMMON の値が使われる
#
# 優先順位: ワールド個別設定（_WORLD_N）> 共通設定（_COMMON）> デフォルト値
#
# ワールドを追加するには:
#   1. make add PORT=19132  （compose ファイル生成 + ポート番号の .env 追記を自動化）
#   2. 差分がある設定項目のみ _WORLD_N= のコメントを外して値を設定

# ================================================
# 管理者 XUID(EducationOid)（初回起動時の permissions.json 生成に使用）
# ================================================
# 設定すると、permissions.json が存在しない場合にオペレーターとして自動登録される

OPERATOR_XUID_COMMON=
# OPERATOR_XUID_WORLD_1=
# OPERATOR_XUID_WORLD_2=


# ================================================
# ゲームモード
# ================================================
# 使用可能な値: "survival"（サバイバル）, "creative"（クリエイティブ）, "adventure"（アドベンチャー）

GAMEMODE_COMMON=creative
# GAMEMODE_WORLD_1=
# GAMEMODE_WORLD_2=

# ================================================
# 難易度
# ================================================
# 使用可能な値: "peaceful"（ピースフル）, "easy"（イージー）, "normal"（ノーマル）, "hard"（ハード）

DIFFICULTY_COMMON=easy
# DIFFICULTY_WORLD_1=
# DIFFICULTY_WORLD_2=

# ================================================
# ワールド名
# ================================================
# 使用可能な値: 任意の文字列

LEVEL_NAME_COMMON=Education level
# LEVEL_NAME_WORLD_1=
# LEVEL_NAME_WORLD_2=

# ================================================
# 最大プレイヤー数
# ================================================
# 使用可能な値: 任意の正の整数

MAX_PLAYERS_COMMON=10
# MAX_PLAYERS_WORLD_1=
# MAX_PLAYERS_WORLD_2=

# ================================================
# 新規プレイヤーの権限レベル
# ================================================
# 注意: この設定はワールド作成時に確定します。後から変更しても既存ワールドには反映されません。
#       変更するにはワールドデータ（worlds/world{N}/）を削除して再作成する必要があります。
# 注意: 教師アカウント（Faculty ライセンス）は常にオペレーターとして参加し、権限を自由に変更できます。
# 使用可能な値: "visitor"（訪問者）, "member"（メンバー）, "operator"（オペレーター）

DEFAULT_PLAYER_PERMISSION_LEVEL_COMMON=member
# DEFAULT_PLAYER_PERMISSION_LEVEL_WORLD_1=
# DEFAULT_PLAYER_PERMISSION_LEVEL_WORLD_2=

# ================================================
# コマンド使用許可（MakeCode・スラッシュコマンド等）
# ================================================
# falseの場合、コマンドはサーバーコンソールのみ使用可能（クライアントからは使用不可）
# 注意: MakeCode を使用するには true にする必要があります
# 使用可能な値: "true"または"false"

ALLOW_COMMANDS_COMMON=true
# ALLOW_COMMANDS_WORLD_1=
# ALLOW_COMMANDS_WORLD_2=

# ================================================
# 接続制限（ホワイトリスト）
# ================================================
# trueの場合、allowlist.json に登録されたプレイヤーのみ接続可能
# 使用可能な値: "true"または"false"

ALLOW_LIST_COMMON=false
# ALLOW_LIST_WORLD_1=
# ALLOW_LIST_WORLD_2=

# ================================================
# チャット制限
# ================================================
# "None":     通常の自由なチャット
# "Dropped":  チャットメッセージは破棄。プレイヤーに無効である旨が通知される。MakeCode は引き続き使用可能
# "Disabled": オペレーター以外はチャットUIが非表示。MakeCode は使用可能だが、チャット経由の入出力は不可
# 使用可能な値: "None", "Dropped", "Disabled"

CHAT_RESTRICTION_COMMON=None
# CHAT_RESTRICTION_WORLD_1=
# CHAT_RESTRICTION_WORLD_2=

# ================================================
# テクスチャパック強制適用
# ================================================
# 使用可能な値: "true"または"false"

TEXTUREPACK_REQUIRED_COMMON=true
# TEXTUREPACK_REQUIRED_WORLD_1=
# TEXTUREPACK_REQUIRED_WORLD_2=

# ================================================
# プレイヤー同士の干渉制限
# ================================================
# trueの場合、プレイヤー同士がすり抜け可能になり、直接攻撃できなくなります
# ブロック設置/破壊、TNT爆発などの間接的な影響は引き続き有効です
# 使用可能な値: "true"または"false"

DISABLE_PLAYER_INTERACTION_COMMON=false
# DISABLE_PLAYER_INTERACTION_WORLD_1=
# DISABLE_PLAYER_INTERACTION_WORLD_2=

# ================================================
# カスタムスキン無効化
# ================================================
# trueの場合、Minecraft外でカスタマイズされたプレイヤースキンを無効にします
# 使用可能な値: "true"または"false"

DISABLE_CUSTOM_SKINS_COMMON=false
# DISABLE_CUSTOM_SKINS_WORLD_1=
# DISABLE_CUSTOM_SKINS_WORLD_2=

# ================================================
# 表示距離（チャンク単位）
# ================================================
# 使用可能な値: 5以上の正の整数

VIEW_DISTANCE_COMMON=32
# VIEW_DISTANCE_WORLD_1=
# VIEW_DISTANCE_WORLD_2=

# ================================================
# ティック距離
# ================================================
# プレイヤーから何チャンク離れた範囲まで更新されるか
# 使用可能な値: 4～12の整数

TICK_DISTANCE_COMMON=4
# TICK_DISTANCE_WORLD_1=
# TICK_DISTANCE_WORLD_2=

# ================================================
# アイドルタイムアウト（分）
# ================================================
# この時間アイドル状態のプレイヤーはキックされる
# 0に設定するとプレイヤーは無期限にアイドル状態でいられます
# 使用可能な値: 任意の非負整数

PLAYER_IDLE_TIMEOUT_COMMON=30
# PLAYER_IDLE_TIMEOUT_WORLD_1=
# PLAYER_IDLE_TIMEOUT_WORLD_2=

# ================================================
# 最大スレッド数
# ================================================
# 0に設定するか削除すると、可能な限り多くのスレッドを使用します
# 使用可能な値: 任意の正の整数

MAX_THREADS_COMMON=8
# MAX_THREADS_WORLD_1=
# MAX_THREADS_WORLD_2=

# ================================================
# コンテンツエラーログ記録
# ================================================
# 使用可能な値: "true"または"false"

CONTENT_LOG_FILE_ENABLED_COMMON=false
# CONTENT_LOG_FILE_ENABLED_WORLD_1=
# CONTENT_LOG_FILE_ENABLED_WORLD_2=

# ================================================
# チャットログ記録（Vector 通知に必要）
# ================================================
# trueの場合、chat_logs/ にチャットログファイル（ChatLog_*.txt）が出力される
# Vector でチャット通知を使用する場合は true にする必要があります
# 使用可能な値: "true"または"false"

CHAT_LOGGING_ENABLED_COMMON=true
# CHAT_LOGGING_ENABLED_WORLD_1=
# CHAT_LOGGING_ENABLED_WORLD_2=

# ================================================
# Code Builder（MakeCode）許可
# ================================================
# 使用可能な値: "true"または"false"

ALLOW_CODE_BUILDER_COMMON=true
# ALLOW_CODE_BUILDER_WORLD_1=
# ALLOW_CODE_BUILDER_WORLD_2=

# ================================================
# コマンドブロック許可
# ================================================
# 使用可能な値: "true"または"false"

ALLOW_COMMAND_BLOCKS_COMMON=true
# ALLOW_COMMAND_BLOCKS_WORLD_1=
# ALLOW_COMMAND_BLOCKS_WORLD_2=

# ================================================
# ワールドシード値（任意、個別設定のみ）
# ================================================
# 注意: ワールド生成時のみ有効。生成済みのワールドには影響しません
# 使用可能な値: 任意の整数

# LEVEL_SEED_WORLD_1=
# LEVEL_SEED_WORLD_2=

# ================================================
# ポート番号（ワールドごとに必須、共通設定なし）
# ================================================
# 注意: 教育版はIPv6に非対応のため、IPv4ポートのみ設定してください
# 複数ワールド運用時は各ワールドで異なるポート番号を使用してください
# 使用可能な値: 1～65535の整数
# make add PORT=19132 を実行すると自動追記されます
